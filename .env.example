# CMe local development configuration.
# Copy to .env and keep real credentials out of Git.

CME_APP_ENV=development
CME_API_PREFIX=/api/v1

# Reserved for the persistence/queue integration phase.
CME_DATABASE_URL=postgresql+psycopg://cme:cme@postgres:5432/cme
CME_REDIS_URL=redis://redis:6379/0
CME_S3_ENDPOINT=http://minio:9000
CME_S3_BUCKET=cme
